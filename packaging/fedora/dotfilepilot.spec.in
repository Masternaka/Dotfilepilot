Name:           dotfilepilot
Version:        @NATIVE_VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Gestion des dotfiles avec sauvegardes et interface GTK4
# Métadonnée descriptive pour un artefact privé ; aucune licence n'est accordée.
License:        Unspecified
Source0:        dotfilepilot-@VERSION@.tar.gz
BuildArch:      noarch
BuildRequires:  python3-devel
BuildRequires:  pyproject-rpm-macros
BuildRequires:  python3-setuptools
BuildRequires:  python3-wheel
BuildRequires:  stow
Requires:       python3 >= 3.9
Requires:       python3-gobject
Requires:       gtk4
Requires:       git
Requires:       stow
Requires:       sudo

%description
Moteur Python, terminal et interface GTK4 utilisant GNU Stow.
L'installation du paquet n'active aucune configuration.

%prep
%setup -q -n dotfilepilot-@VERSION@

%build
%pyproject_wheel

%install
%pyproject_install
python3 -B scripts/stage_desktop.py --root %{buildroot}

%check
DOTFILEPILOT_TEST_STOW=1 python3 -B scripts/run_tests.py

%files
%doc README.md
%{_bindir}/dotfilepilot
%{python3_sitelib}/dotfilepilot/
%{python3_sitelib}/dotfilepilot-*.dist-info/
%{_datadir}/applications/io.github.dotfilepilot.App.desktop
%{_datadir}/icons/hicolor/*/apps/io.github.dotfilepilot.App*.svg
%{_datadir}/icons/hicolor/*/apps/io.github.dotfilepilot.App.png
