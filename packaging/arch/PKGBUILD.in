# Généré par scripts/prepare_arch_build.py ; ne pas utiliser ce modèle directement.
pkgname=dotfilepilot
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Gestion des dotfiles avec GNU Stow, sauvegardes et interface GTK4'
arch=('any')
# Aucune licence choisie dans le projet : à définir avant distribution publique.
depends=('python' 'gtk4' 'python-gobject' 'git' 'stow' 'sudo')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -B scripts/check.py
    DOTFILEPILOT_TEST_STOW=1 python -B scripts/run_tests.py
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 packaging/arch/dotfilepilot.desktop \
        "${pkgdir}/usr/share/applications/io.github.dotfilepilot.App.desktop"
    local icons="dotfilepilot/assets/icons"
    local icon_name="io.github.dotfilepilot.App"
    install -Dm644 "${icons}/${icon_name}.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${icon_name}.svg"
    install -Dm644 "${icons}/${icon_name}-symbolic.svg" \
        "${pkgdir}/usr/share/icons/hicolor/symbolic/apps/${icon_name}-symbolic.svg"
    install -Dm644 "${icons}/${icon_name}.png" \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${icon_name}.png"
    local size
    for size in 16 24 32 48 64 128 256 1024; do
        install -Dm644 "${icons}/${size}x${size}/${icon_name}.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${icon_name}.png"
    done
}
